[Unit]
Description=Cycling Food Lodging Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cyclingagent
Group=cyclingagent
WorkingDirectory=/opt/cycling-food-lodging-agent
ExecStart=/opt/cycling-food-lodging-agent/.venv/bin/python -m uvicorn web_main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/cycling-food-lodging-agent/.runtime

[Install]
WantedBy=multi-user.target
